{
  "manifest_version": 2,
  "name": "Zotero AI Note",
  "version": "0.2.16",
  "description": "Summarize selected PDF papers with Qwen, DeepSeek, or Zhipu GLM and save the result as a Zotero child note.",
  "author": "Duyang",
  "homepage_url": "https://github.com/nkbaim/zotero-ai-note",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-ai-note@duyang.dev",
      "update_url": "https://raw.githubusercontent.com/nkbaim/zotero-ai-note/main/updates.json",
      "strict_min_version": "8.999",
      "strict_max_version": "9.0.*"
    }
  }
}
